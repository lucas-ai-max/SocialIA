# Server
PORT=4000
# Aceita um URL unico ou lista separada por virgulas
FRONTEND_URL=http://localhost:3000,http://localhost:3001

# Supabase
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Composio
COMPOSIO_API_KEY=your_composio_api_key
COMPOSIO_INSTAGRAM_AUTH_CONFIG_ID=your_composio_instagram_auth_config_id

# Replicate (usado para geracao de imagens - google/nano-banana-pro = Gemini 3 Pro Image)
REPLICATE_API_TOKEN=your_replicate_api_token

# OpenAI (usado para captions, hashtags e ideias de texto - gpt-4.1-mini)
OPENAI_API_KEY=your_openai_api_key

# Kiwify
KIWIFY_WEBHOOK_SECRET=your_kiwify_webhook_token
KIWIFY_CHECKOUT_URL_STARTER=https://pay.kiwify.com.br/xxxx
KIWIFY_CHECKOUT_URL_PRO=https://pay.kiwify.com.br/xxxx
KIWIFY_CHECKOUT_URL_BUSINESS=https://pay.kiwify.com.br/xxxx
KIWIFY_PLAN_ID_STARTER=
KIWIFY_PLAN_ID_PRO=
KIWIFY_PLAN_ID_BUSINESS=

# Cron
CRON_SECRET=your_cron_secret
